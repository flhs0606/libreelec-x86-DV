+
+bool CDVDInputStreamBluray::ArmSeamlessGlide()
+{
+  const bool isPlayitem = (m_event.event == BD_EVENT_PLAYITEM);
+  const bool isPlaylistWrap = (m_event.event == BD_EVENT_PLAYLIST && m_event.param == m_playlist);
+  m_seamlessHold = isPlayitem || isPlaylistWrap;
+
+  const BLURAY_CLIP_INFO* next = nullptr;
+  if (m_titleInfo && m_event.param < m_titleInfo->clip_count)
+  {
+    if (isPlayitem)
+      next = &m_titleInfo->clips[m_event.param];
+    else if (isPlaylistWrap && m_titleInfo->clip_count > 0)
+      next = &m_titleInfo->clips[0];
+  }
+
+  const int cc = next ? next->connection_condition : -1;
+  CLog::Log(LOGDEBUG,
+            "CDVDInputStreamBluray::ArmSeamlessGlide - event: {}, param: {}, hold: {}, "
+            "allowed: {}, titleInfo: {}, next: {}, cc: {}",
+            m_event.event, m_event.param, m_seamlessHold, m_seamlessGlideAllowed,
+            m_titleInfo != nullptr, next != nullptr, cc);
+
+  if (m_seamlessHold && m_seamlessGlideAllowed && ClipConnectionIsSeamless(next))
+  {
+    CLog::Log(LOGINFO,
+              "CDVDInputStreamBluray - gliding seamless seam at playitem {} (connection_condition {})",
+              m_event.param, cc);
+    m_pendingSeamlessTransition = true;
+    m_clip = const_cast<BLURAY_CLIP_INFO*>(next);
+    return true;
+  }
+  return false;
+}

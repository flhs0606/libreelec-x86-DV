index 0000000000000000000000000000000000000000..d86acf5979ef283a3341b28bfee7619ecc613c0c
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayDovi.h
@@ -0,0 +1,414 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <memory>
+#include <vector>
+#include "utils/log.h"
+extern "C"
+{
+#include <libavcodec/packet.h>
+#include <libavutil/avutil.h>
+#include <libavutil/error.h>
+}
+
+// Present separate Blu-ray layers as the joined HEVC stream consumed by CB1.
+class CBlurayDovi
+{
+public:
+  void Reset()
+  {
+    m_base.clear();
+    m_enhancement.clear();
+    m_bytes = 0;
+    m_lastBasePts = AV_NOPTS_VALUE;
+    m_lastElPts = AV_NOPTS_VALUE;
+    m_lastTakenBasePts = AV_NOPTS_VALUE;
+    m_lastElNalType = -1;
+    m_hasLayer = false;
+    m_inTransition = false;
+    m_eof = false;
+  }
+
+  void SetEOF() { m_eof = true; }
+
+  bool Push(const AVPacket* packet, bool enhancement)
+  {
+    if (!packet || packet->size <= 0)
+      return true;
+
+    // Safety memory ceiling (128MB)
+    if (m_bytes + static_cast<size_t>(packet->size) > MAX_BYTES)
+      DropOldest();
+
+    if (!enhancement)
+    {
+      // Reassemble continuation BL packets (without PTS, or matching previous PTS)
+      if (packet->pts == AV_NOPTS_VALUE || (!m_base.empty() && packet->pts == m_base.back()->pts))
+      {
+        if (!m_base.empty())
+        {
+          auto& back = m_base.back();
+          int oldSize = back->size;
+          if (av_grow_packet(back.get(), packet->size) >= 0)
+          {
+            std::memcpy(back->data + oldSize, packet->data, packet->size);
+            m_bytes += packet->size;
+          }
+        }
+        return true;
+      }
+
+      if (m_base.size() >= MAX_PACKETS)
+        DropOldest();
+
+      // Seamless branching backward time jump detection (> 2.0s negative jump)
+      if (m_lastBasePts != AV_NOPTS_VALUE && packet->pts != AV_NOPTS_VALUE &&
+          packet->pts < m_lastBasePts - 90000 * 2)
+      {
+        m_inTransition = true;
+        CLog::Log(LOGDEBUG, "DV Blu-ray: BL transition detected: {} -> {}", m_lastBasePts, packet->pts);
+      }
+      m_lastBasePts = packet->pts;
+
+      // Scan and strip HEVC EOS (36) and EOB (37) NALs from Base Layer (nalSize == 2)
+      Packet owned;
+      if (ContainsEosNal(packet->data, packet->size))
+      {
+        CLog::Log(LOGDEBUG, "DV Blu-ray: stripping BL EOS/EOB NAL units");
+        auto filtered = StripEosNalUnits(packet->data, packet->size);
+        owned.reset(av_packet_alloc());
+        if (owned && av_new_packet(owned.get(), filtered.size()) >= 0)
+        {
+          std::memcpy(owned->data, filtered.data(), filtered.size());
+          av_packet_copy_props(owned.get(), packet);
+        }
+        else
+        {
+          owned.reset(av_packet_clone(packet));
+        }
+      }
+      else
+      {
+        owned.reset(av_packet_clone(packet));
+      }
+
+      if (!owned)
+        return true;
+
+      m_bytes += owned->size;
+      m_base.push_back(std::move(owned));
+      return true;
+    }
+
+    // Enhancement layer packet
+    int64_t pts = packet->pts;
+    if (pts == AV_NOPTS_VALUE)
+    {
+      if (m_lastElPts != AV_NOPTS_VALUE)
+        pts = m_lastElPts;
+      else
+        return true;
+    }
+    else
+    {
+      if (m_lastElPts != AV_NOPTS_VALUE && pts < m_lastElPts - 90000 * 2)
+      {
+        m_inTransition = true;
+        CLog::Log(LOGDEBUG, "DV Blu-ray: EL transition detected: {} -> {}", m_lastElPts, pts);
+      }
+      m_lastElPts = packet->pts;
+    }
+
+    std::vector<uint8_t> layer, rpu;
+    auto begin = Start(packet->data, packet->size, 0);
+
+    // If packet starts without NAL start code, append payload chunk to previous NAL
+    if (begin[0] > 0 && m_lastElNalType != -1)
+    {
+      auto& dest = (m_lastElNalType == 62) ? rpu : layer;
+      dest.insert(dest.end(), packet->data, packet->data + begin[0]);
+    }
+
+    while (begin[0] < packet->size)
+    {
+      const auto next = Start(packet->data, packet->size, begin[1]);
+      const int size = next[0] - begin[1];
+      if (size >= 2 && !(packet->data[begin[1]] & 0x80) && (packet->data[begin[1] + 1] & 7))
+      {
+        const int type = (packet->data[begin[1]] >> 1) & 63;
+        // Intercept and strip HEVC EOS (36) and EOB (37) NALs from Enhancement Layer
+        if (size == 2 && (type == 36 || type == 37))
+        {
+          CLog::Log(LOGDEBUG, "DV Blu-ray: stripping EL EOS/EOB NAL type={}", type);
+          begin = next;
+          continue;
+        }
+
+        m_lastElNalType = type;
+        if (type == 62)
+        {
+          rpu.insert(rpu.end(), {0, 0, 0, 1});
+          rpu.insert(rpu.end(), packet->data + begin[1], packet->data + next[0]);
+        }
+        else
+        {
+          layer.insert(layer.end(), {0, 0, 0, 1, 0x7e, 1});
+          layer.insert(layer.end(), packet->data + begin[1], packet->data + next[0]);
+        }
+      }
+      begin = next;
+    }
+
+    if (!layer.empty())
+      m_hasLayer = true;
+
+    if (!layer.empty() || !rpu.empty())
+    {
+      auto& unit = m_enhancement[pts];
+      if (!layer.empty())
+        unit.layer.insert(unit.layer.end(), layer.begin(), layer.end());
+      if (!rpu.empty())
+      {
+        if (unit.rpu.empty())
+          unit.rpu = std::move(rpu);
+        else
+          CLog::Log(LOGDEBUG, "DV Blu-ray: unit at pts {} already has RPU, keeping first", pts);
+      }
+
+      m_bytes += layer.size() + rpu.size();
+    }
+
+    return true;
+  }
+
+  int Take(AVPacket* output)
+  {
+    // 1-frame lookahead gate: never emit incomplete 4K frame before all its continuation slices arrive
+    if (m_base.empty() || (m_base.size() < 2 && !m_eof))
+      return AVERROR(EAGAIN);
+
+    auto& basePkt = m_base.front();
+    const int64_t targetPts = basePkt->pts;
+
+    // Check if Take() has crossed into the new segment
+    if (m_lastTakenBasePts != AV_NOPTS_VALUE && targetPts != AV_NOPTS_VALUE &&
+        targetPts < m_lastTakenBasePts - 90000 * 2)
+    {
+      CLog::Log(LOGDEBUG,
+                "DV Blu-ray: Take crossed seam to new segment (pts {} < last taken {}). Purging old segment stragglers.",
+                targetPts, m_lastTakenBasePts);
+      for (auto it = m_enhancement.begin(); it != m_enhancement.end(); )
+      {
+        if (it->first > targetPts + 90000 * 2)
+        {
+          m_bytes -= (it->second.layer.size() + it->second.rpu.size());
+          it = m_enhancement.erase(it);
+        }
+        else
+        {
+          ++it;
+        }
+      }
+      m_inTransition = false;
+      m_lastTakenBasePts = targetPts; // Update immediately to eliminate duplicate logs on EAGAIN
+    }
+
+    // Do NOT discard orphan packets without PTS: emit as standalone Base Layer!
+    if (targetPts == AV_NOPTS_VALUE)
+    {
+      av_packet_move_ref(output, basePkt.get());
+      m_bytes -= basePkt->size;
+      m_base.pop_front();
+      return 0;
+    }
+
+    // 1. Exact PTS matching (BL and EL share identical 90kHz PTS in Blu-ray M2TS)
+    auto it = m_enhancement.find(targetPts);
+    if (it != m_enhancement.end())
+    {
+      const auto& unit = it->second;
+      const int baseSize = basePkt->size;
+      const bool blHasRpu = ContainsRpuNal(basePkt->data, basePkt->size);
+      const size_t rpuSize = blHasRpu ? 0 : unit.rpu.size();
+      const size_t extra = unit.layer.size() + rpuSize;
+
+      Packet joined(av_packet_clone(basePkt.get()));
+      if (!joined || (extra > 0 && av_grow_packet(joined.get(), extra) < 0))
+      {
+        av_packet_move_ref(output, basePkt.get());
+        m_bytes -= basePkt->size;
+        m_base.pop_front();
+        m_lastTakenBasePts = targetPts;
+        return 0;
+      }
+
+      if (!unit.layer.empty())
+        std::memcpy(joined->data + baseSize, unit.layer.data(), unit.layer.size());
+      if (rpuSize > 0)
+        std::memcpy(joined->data + baseSize + unit.layer.size(), unit.rpu.data(), rpuSize);
+
+      m_bytes -= (baseSize + extra);
+      av_packet_move_ref(output, joined.get());
+
+      m_base.pop_front();
+      m_enhancement.erase(it);
+      m_lastTakenBasePts = targetPts;
+
+      if (!m_inTransition)
+        CleanStale(targetPts);
+      return 0;
+    }
+
+    // 2. Anti-starvation fallback: if Base Layer accumulates beyond threshold without matching EL,
+    // emit as standalone Base Layer (HDR10) to prevent any hang or freeze.
+    if (m_base.size() >= STARVATION_THRESHOLD)
+    {
+      CLog::Log(LOGWARNING, "DV Blu-ray: Take STARVATION fallback BL pts={} q_base={}", targetPts, m_base.size());
+      av_packet_move_ref(output, basePkt.get());
+      m_bytes -= basePkt->size;
+      m_base.pop_front();
+      m_lastTakenBasePts = targetPts;
+      return 0;
+    }
+
+    return AVERROR(EAGAIN);
+  }
+
+  bool Pending() const { return !m_base.empty() || !m_enhancement.empty(); }
+
+private:
+  static constexpr size_t MAX_PACKETS = 256;
+  static constexpr size_t STARVATION_THRESHOLD = 64;
+  static constexpr size_t MAX_BYTES = 128u * 1024u * 1024u;
+
+  struct Release { void operator()(AVPacket* p) const { av_packet_free(&p); } };
+  using Packet = std::unique_ptr<AVPacket, Release>;
+
+  struct EnhancementUnit
+  {
+    std::vector<uint8_t> layer;
+    std::vector<uint8_t> rpu;
+  };
+
+  // Return the prefix and payload positions of the next Annex-B NAL.
+  static std::array<int, 2> Start(const uint8_t* data, int size, int from)
+  {
+    for (int i = from; i < size - 2; ++i)
+    {
+      if (data[i] || data[i + 1])
+        continue;
+      if (data[i + 2] == 1)
+        return {i, i + 3};
+      if (i < size - 3 && !data[i + 2] && data[i + 3] == 1)
+        return {i, i + 4};
+    }
+    return {size, size};
+  }
+
+  static bool ContainsEosNal(const uint8_t* data, int size)
+  {
+    auto begin = Start(data, size, 0);
+    while (begin[0] < size)
+    {
+      const auto next = Start(data, size, begin[1]);
+      const int nalSize = next[0] - begin[1];
+      if (nalSize == 2)
+      {
+        const int type = (data[begin[1]] >> 1) & 63;
+        if (type == 36 || type == 37)
+          return true;
+      }
+      begin = next;
+    }
+    return false;
+  }
+
+  static bool ContainsRpuNal(const uint8_t* data, int size)
+  {
+    auto begin = Start(data, size, 0);
+    while (begin[0] < size)
+    {
+      const auto next = Start(data, size, begin[1]);
+      if (next[0] - begin[1] >= 2)
+      {
+        const int type = (data[begin[1]] >> 1) & 63;
+        if (type == 62)
+          return true;
+      }
+      begin = next;
+    }
+    return false;
+  }
+
+  static std::vector<uint8_t> StripEosNalUnits(const uint8_t* data, int size)
+  {
+    std::vector<uint8_t> filtered;
+    filtered.reserve(size);
+    auto begin = Start(data, size, 0);
+    if (begin[0] > 0)
+    {
+      filtered.insert(filtered.end(), data, data + begin[0]);
+    }
+    while (begin[0] < size)
+    {
+      const auto next = Start(data, size, begin[1]);
+      const int nalSize = next[0] - begin[1];
+      if (nalSize == 2)
+      {
+        const int type = (data[begin[1]] >> 1) & 63;
+        if (type == 36 || type == 37)
+        {
+          begin = next;
+          continue;
+        }
+      }
+      filtered.insert(filtered.end(), {0, 0, 0, 1});
+      filtered.insert(filtered.end(), data + begin[1], data + next[0]);
+      begin = next;
+    }
+    return filtered;
+  }
+
+  void DropOldest()
+  {
+    if (!m_base.empty())
+    {
+      m_bytes -= m_base.front()->size;
+      m_base.pop_front();
+    }
+    else if (!m_enhancement.empty())
+    {
+      auto it = m_enhancement.begin();
+      m_bytes -= (it->second.layer.size() + it->second.rpu.size());
+      m_enhancement.erase(it);
+    }
+  }
+
+  void CleanStale(int64_t currentPts)
+  {
+    if (m_inTransition || currentPts == AV_NOPTS_VALUE)
+      return;
+    while (!m_enhancement.empty() && m_enhancement.begin()->first < currentPts - 90000 * 2)
+    {
+      auto it = m_enhancement.begin();
+      m_bytes -= (it->second.layer.size() + it->second.rpu.size());
+      m_enhancement.erase(it);
+    }
+  }
+
+  std::deque<Packet> m_base;
+  std::map<int64_t, EnhancementUnit> m_enhancement;
+  size_t m_bytes{0};
+  int64_t m_lastBasePts{AV_NOPTS_VALUE};
+  int64_t m_lastElPts{AV_NOPTS_VALUE};
+  int64_t m_lastTakenBasePts{AV_NOPTS_VALUE};
+  int m_lastElNalType{-1};
+  bool m_hasLayer{false};
+  bool m_inTransition{false};
+  bool m_eof{false};
+};

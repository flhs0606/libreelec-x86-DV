+void CDVBridgeGLES::ReportDoviEngine()
+{
+  // Report the engine decision once per stream so a fallback is never silent.
+  // Called after presentation: the curve is only selected during the first render.
+  if (m_doviReportedStream == m_pendingIdentity.stream)
+    return;
+  m_doviReportedStream = m_pendingIdentity.stream;
+  const char* dovi = dvbridge_renderer_dovi_status(m_renderer);
+  if (m_requested.doviEngine && dovi && std::strcmp(dovi, "ready") != 0)
+    CLog::Log(LOGWARNING, "DVBridge dovi engine unavailable ({}), using the CB1 default path", dovi);
+  else if (m_requested.doviEngine)
+    CLog::Log(LOGINFO, "DVBridge dovi engine active: reference tone curve");
+  else
+    CLog::Log(LOGINFO, "DVBridge dovi engine off by preference, using the CB1 default path");
+}

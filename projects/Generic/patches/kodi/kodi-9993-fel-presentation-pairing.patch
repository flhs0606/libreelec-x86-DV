+        {
+          avpkt->size = i;
+          break;
+        }
+        if (i < avpkt->size - 6 && avpkt->data[i + 2] == 0 && avpkt->data[i + 3] == 1 &&
+            avpkt->data[i + 4] == 0x7e && (avpkt->data[i + 5] & 7) == 1)

+                    m_dvPending.size());
+          m_dvPending.clear();
+          return VC_EOF;
+        }
+        base->doviEnhancement.reset();
+        pVideoPicture->CopyRef(*base);
+        m_dvPending.pop_front();
+        return VC_PICTURE;
+      }
       if (!result)
+      {
+        if (++m_dvWaitCount > 2 || m_dvPending.size() > 2)
+        {
+          m_dvWaitCount = 0;
+          base->doviEnhancement.reset();
+          pVideoPicture->CopyRef(*base);
+          m_dvPending.pop_front();
+          return VC_PICTURE;
+        }
         return VC_NONE;
+      }
+      m_dvWaitCount = 0;
       base->doviEnhancement = {enhancement, [](AVFrame* f) { av_frame_free(&f); }};
       pVideoPicture->CopyRef(*base);
       m_dvPending.pop_front();
       return VC_PICTURE;
